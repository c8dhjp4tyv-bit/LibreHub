# LibreHub API configuration for a production host.
#
# Install as /etc/librehub/librehub.env with owner root:librehub and mode 0640.
# This file holds NO secrets. Every secret is a path to a file under /etc/librehub/secrets,
# which must be readable only by the service account (see scripts/provision.sh).
# Validate before starting: /usr/local/bin/librehub-api --check-config

LIBREHUB_ENVIRONMENT=production
LIBREHUB_LOG_FORMAT=json

# Storage. Persistent state lives only under this directory (see docs/production-deployment.md).
LIBREHUB_DATA_DIR=/var/lib/librehub/data
LIBREHUB_DATABASE_PATH=/var/lib/librehub/data/builds.sqlite3

# Listeners. The API and metrics bind private addresses only. The TLS proxy is the only public
# listener. 172.17.0.1 is the default Docker bridge gateway; change both if your bridge differs.
LIBREHUB_BIND=172.17.0.1:8080
LIBREHUB_METRICS_BIND=172.17.0.1:9464
# Peers allowed to set X-Forwarded-For. Forwarded headers from anyone else are ignored.
LIBREHUB_TRUSTED_PROXIES=172.17.0.1

# Public origins. HTTPS only; TLS terminates at the proxy.
LIBREHUB_API_PUBLIC_URL=https://api.librehub.example
LIBREHUB_WEB_PUBLIC_URL=https://librehub.example
LIBREHUB_PUBLIC_BASE_URL=https://repo.librehub.example/repo

# Supply-chain and isolation policy. Production requires both.
LIBREHUB_SUPPLY_CHAIN_POLICY=enforce
LIBREHUB_WORKER_ISOLATION=hardened
LIBREHUB_WORKER_NETWORK=none
# Pin the worker image by digest in the release manifest, never by a mutable tag.
LIBREHUB_WORKER_IMAGE=librehub-worker@sha256:REPLACE_WITH_RELEASE_DIGEST
LIBREHUB_DOCKER=/usr/bin/docker
# Build containers talk to a rootless daemon owned by the build account, not to the system daemon.
DOCKER_HOST=unix:///run/librehub-builder/docker.sock

# Publishing: flat-manager (internal) and the repository signing public key.
LIBREHUB_FLAT_MANAGER_URL=http://127.0.0.1:8081
LIBREHUB_FLAT_MANAGER_TOKEN_FILE=/etc/librehub/secrets/publisher.token
LIBREHUB_SIGNING_PUBLIC_KEY_FILE=/etc/librehub/public/repository.gpg
LIBREHUB_SIGNING_FINGERPRINT=REPLACE_WITH_REPOSITORY_GPG_FINGERPRINT
LIBREHUB_PUBLISH_CONCURRENCY=1

# M6 attestation: the Ed25519 attestor seed is a secret; the key bundle is public.
LIBREHUB_ATTESTOR_KEY_FILE=/etc/librehub/secrets/attestor-seed
LIBREHUB_ATTESTOR_KEYS_FILE=/etc/librehub/public/attestor-keys.json

# M7 identity federation. The audience is the value your workflows request.
LIBREHUB_OIDC_AUDIENCE=librehub-ci-github
LIBREHUB_OIDC_ISSUER=https://token.actions.githubusercontent.com

# Capacity. New builds are refused (503) below this much free space on the data directory.
LIBREHUB_MIN_FREE_BYTES=2147483648
